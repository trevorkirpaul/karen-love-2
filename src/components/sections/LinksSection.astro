---
import { ChevronRight, Info } from "@lucide/astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/starwind/card";
import {
  Item,
  ItemActions,
  ItemContent,
  ItemDescription,
  ItemGroup,
  ItemTitle,
} from "@/components/starwind/item";
import { HELPFUL_LINKS } from "@/data/profile";
---

<Card id="links" class="scroll-mt-20 border-border bg-card shadow-sm">
  <CardHeader class="border-b border-border px-6 py-5">
    <p class="text-xs font-semibold tracking-wider text-pink-700 uppercase dark:text-pink-400">
      Patient Education
    </p>
    <CardTitle class="mt-1 text-xl font-bold text-foreground">Helpful Resources</CardTitle>
  </CardHeader>

  <CardContent class="p-6">
    <ItemGroup class="gap-2.5">
      {
        HELPFUL_LINKS.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pink-600"
          >
            <Item
              variant="muted"
              class="border-border bg-muted/50 transition-colors group-hover:border-pink-300 group-hover:bg-pink-50/70 dark:group-hover:border-pink-700 dark:group-hover:bg-pink-950/35"
            >
              <ItemContent>
                <ItemTitle class="text-foreground group-hover:text-pink-700 dark:group-hover:text-pink-300">
                  {link.title}
                </ItemTitle>
                {link.subTitle && (
                  <ItemDescription class="flex items-start gap-1.5 text-muted-foreground">
                    <Info class="mt-0.5 size-3.5 shrink-0 text-pink-600 dark:text-pink-400" aria-hidden="true" />
                    <span>{link.subTitle}</span>
                  </ItemDescription>
                )}
              </ItemContent>
              <ItemActions>
                <ChevronRight
                  class="size-4 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-pink-600 dark:group-hover:text-pink-400"
                  aria-hidden="true"
                />
              </ItemActions>
            </Item>
          </a>
        ))
      }
    </ItemGroup>
  </CardContent>
</Card>
