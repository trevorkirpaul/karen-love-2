---
import { Calendar, MapPin, Phone } from "@lucide/astro";
import { APPOINTMENT_URL, DOCTOR_PROFILE, LOCATIONS } from "@/data/profile";

const currentYear = new Date().getFullYear();
const primaryLocation = LOCATIONS[0];
---

<footer class="mt-16 border-t border-border bg-zinc-900 text-zinc-200 dark:bg-zinc-950">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div class="space-y-2">
        <p class="font-display text-lg font-semibold text-white">{DOCTOR_PROFILE.shortName}</p>
        <p class="text-sm text-zinc-400">{DOCTOR_PROFILE.title}</p>
        <p class="text-xs text-zinc-400">{DOCTOR_PROFILE.serviceArea}</p>
      </div>

      {
        primaryLocation && (
          <div class="space-y-2 text-sm">
            <p class="font-semibold text-white">{primaryLocation.name}</p>
            <p class="flex items-start gap-2 text-zinc-400">
              <MapPin class="mt-0.5 size-4 shrink-0 text-pink-400" aria-hidden="true" />
              <span>{primaryLocation.address}</span>
            </p>
            <p class="flex items-center gap-2 text-zinc-400">
              <Phone class="size-4 shrink-0 text-pink-400" aria-hidden="true" />
              <a href="tel:+19377056100" class="transition-colors hover:text-white">
                {primaryLocation.phone}
              </a>
            </p>
          </div>
        )
      }

      <div class="space-y-2 text-sm">
        <p class="font-semibold text-white">Appointments</p>
        <p class="text-zinc-400">New and returning patients welcome.</p>
        <a
          href={APPOINTMENT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-medium text-pink-400 transition-colors hover:text-pink-300"
        >
          <Calendar class="size-4" aria-hidden="true" />
          Schedule online
        </a>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-2 border-t border-zinc-800 pt-6 text-xs text-zinc-400 sm:flex-row">
      <p>&copy; {currentYear} {DOCTOR_PROFILE.shortName}. All rights reserved.</p>
      <p>Podiatric Medicine &amp; Foot and Ankle Surgery</p>
    </div>
  </div>
</footer>
