---
import { Calendar, Phone } from "@lucide/astro";
import { Button } from "@/components/starwind/button";
import { ThemeToggle } from "@/components/starwind/theme-toggle";
import { APPOINTMENT_URL, DOCTOR_PROFILE, LOCATIONS } from "@/data/profile";

const phone = LOCATIONS[0]?.phone ?? "937-705-6100";
---

<nav
  aria-label="Primary navigation"
  class="sticky top-0 z-40 border-b border-border bg-white/85 backdrop-blur-md dark:bg-zinc-950/85"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a
      href="#"
      class="flex items-center gap-2.5 text-foreground transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pink-600"
    >
      <span
        class="flex size-9 items-center justify-center rounded-lg bg-pink-600 text-sm font-semibold tracking-tight text-white shadow-xs dark:bg-pink-500"
        aria-hidden="true"
      >
        KK
      </span>
      <span class="leading-tight">
        <span class="block text-sm font-semibold text-foreground sm:text-base">
          {DOCTOR_PROFILE.shortName}
        </span>
        <span class="hidden text-xs text-muted-foreground sm:block">{DOCTOR_PROFILE.serviceArea}</span>
      </span>
    </a>

    <div class="hidden items-center gap-6 text-sm font-medium text-muted-foreground md:flex">
      <a href="#services" class="transition-colors hover:text-pink-600 dark:hover:text-pink-400">Services</a>
      <a href="#about" class="transition-colors hover:text-pink-600 dark:hover:text-pink-400">About</a>
      <a href="#contact" class="transition-colors hover:text-pink-600 dark:hover:text-pink-400">Contact</a>
      <a href="#locations" class="transition-colors hover:text-pink-600 dark:hover:text-pink-400">Location</a>
      <a href="#publications" class="transition-colors hover:text-pink-600 dark:hover:text-pink-400">Research</a>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="tel:+19377056100"
        class="hidden items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm font-medium text-foreground/80 transition-colors hover:bg-muted hover:text-pink-600 lg:inline-flex dark:hover:text-pink-400"
      >
        <Phone class="size-4 text-pink-600 dark:text-pink-400" aria-hidden="true" />
        {phone}
      </a>

      <ThemeToggle size="sm" variant="outline" class="border-border bg-card text-foreground hover:bg-muted" />

      <Button
        href={APPOINTMENT_URL}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="sm"
        class="shadow-xs"
      >
        <Calendar class="size-4" aria-hidden="true" />
        <span>Book Visit</span>
      </Button>
    </div>
  </div>
</nav>
