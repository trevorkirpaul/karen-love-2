---
import { Image } from "astro:assets";
import { Award, Calendar, MapPin, MessageSquare, ShieldCheck } from "@lucide/astro";
import doctorPhoto from "@/assets/karen_kirpaul.png";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { APPOINTMENT_URL, DOCTOR_PROFILE, LOCATIONS } from "@/data/profile";

const primaryLocation = LOCATIONS[0];
---

<header class="relative overflow-hidden border-b border-border bg-gradient-to-b from-pink-50/75 via-background to-background dark:from-pink-950/25 dark:via-background dark:to-background">
  <!-- Subtle decorative ambient shapes -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-24 right-0 size-96 rounded-full bg-pink-300/25 blur-3xl dark:bg-pink-600/15"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-24 -left-24 size-80 rounded-full bg-rose-200/35 blur-3xl dark:bg-fuchsia-900/15"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-12 lg:gap-12 lg:px-8 lg:py-20">
    <!-- Editorial Copy -->
    <div class="space-y-6 lg:col-span-7">
      <div class="inline-flex flex-wrap items-center gap-2">
        <Badge
          variant="secondary"
          class="gap-1.5 border border-pink-200 bg-pink-50 px-3 py-1 text-pink-900 dark:border-pink-800/60 dark:bg-pink-950/60 dark:text-pink-200"
        >
          <MapPin class="size-3.5 text-pink-600 dark:text-pink-400" aria-hidden="true" />
          {DOCTOR_PROFILE.serviceArea}
        </Badge>
        <Badge variant="outline" class="border-border bg-card/80 px-3 py-1 text-muted-foreground">
          {DOCTOR_PROFILE.title}
        </Badge>
      </div>

      <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-5xl sm:leading-[1.12]">
          Dr. {DOCTOR_PROFILE.fullName},{" "}
          <span class="text-pink-600 dark:text-pink-400">{DOCTOR_PROFILE.credentials}</span>
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
          Compassionate, evidence-based foot and ankle care—from plantar fasciitis and biomechanics to
          hospital-trained podiatric surgery—proudly serving Kettering, Beavercreek, and the greater Dayton community.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <Button
          href={APPOINTMENT_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          size="lg"
          class="shadow-sm"
        >
          <Calendar class="size-4" aria-hidden="true" />
          Request Appointment
        </Button>

        <Button
          href="#contact"
          variant="outline"
          size="lg"
          class="border-border bg-card text-foreground hover:bg-muted"
        >
          <MessageSquare class="size-4 text-pink-600 dark:text-pink-400" aria-hidden="true" />
          Send a Message
        </Button>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-border pt-5 text-sm text-muted-foreground">
        <div class="inline-flex items-center gap-2">
          <ShieldCheck class="size-4 text-pink-600 dark:text-pink-400" aria-hidden="true" />
          <span>Diplomate, American Board of Podiatric Medicine</span>
        </div>
        <div class="inline-flex items-center gap-2">
          <Award class="size-4 text-pink-600 dark:text-pink-400" aria-hidden="true" />
          <span>APMA Member</span>
        </div>
      </div>
    </div>

    <!-- Framed Portrait -->
    <div class="lg:col-span-5">
      <div class="relative mx-auto max-w-sm lg:max-w-none">
        <div
          aria-hidden="true"
          class="absolute -inset-3 rounded-3xl bg-gradient-to-tr from-pink-600/20 via-rose-400/15 to-stone-200/40 dark:from-pink-500/20 dark:via-fuchsia-600/10 dark:to-zinc-800/40"
        >
        </div>

        <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-3 shadow-xl">
          <div class="overflow-hidden rounded-xl bg-muted">
            <Image
              src={doctorPhoto}
              alt={`${DOCTOR_PROFILE.fullName}, ${DOCTOR_PROFILE.credentials}`}
              width={640}
              height={640}
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/4.2] w-full object-cover object-top"
            />
          </div>

          {
            primaryLocation && (
              <div class="mt-3 flex items-center justify-between gap-3 rounded-xl bg-muted/70 px-4 py-3 text-sm">
                <div class="min-w-0">
                  <p class="truncate font-semibold text-foreground">{primaryLocation.name}</p>
                  <p class="truncate text-xs text-muted-foreground">{primaryLocation.address}</p>
                </div>
                <a
                  href="tel:+19377056100"
                  class="shrink-0 rounded-lg bg-pink-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-pink-700 dark:bg-pink-500 dark:hover:bg-pink-600"
                >
                  {primaryLocation.phone}
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</header>
