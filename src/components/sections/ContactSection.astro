---
import { CircleAlert, CircleCheck, Lock, Send } from "@lucide/astro";
import { Alert, AlertDescription } from "@/components/starwind/alert";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/starwind/card";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { Spinner } from "@/components/starwind/spinner";
import { Textarea } from "@/components/starwind/textarea";
import { DOCTOR_PROFILE } from "@/data/profile";
---

<Card id="contact" class="scroll-mt-20 border-border bg-card shadow-sm">
  <CardHeader class="border-b border-border px-6 py-5">
    <p class="text-xs font-semibold tracking-wider text-pink-700 uppercase dark:text-pink-400">Get In Touch</p>
    <CardTitle class="mt-1 text-2xl font-bold text-foreground">Send a Message</CardTitle>
    <p class="mt-1 text-sm text-muted-foreground">
      Have a question for{" "}
      <strong class="font-semibold text-foreground">Dr. {DOCTOR_PROFILE.fullName}, {DOCTOR_PROFILE.credentials}</strong>?
      Complete the form below and our team will follow up.
    </p>
  </CardHeader>

  <CardContent class="p-6">
    <form id="contact-form" action="/api/contact" method="post" class="space-y-4" novalidate>
      <!-- Honeypot fields for automated bot filtering -->
      <div
        class="sr-only"
        aria-hidden="true"
        style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; z-index: -1;"
      >
        <label for="contact-website">Leave this field empty</label>
        <input id="contact-website" type="text" name="website" tabindex="-1" autocomplete="off" />
        <label for="contact-company">Do not fill this field</label>
        <input id="contact-company" type="text" name="company" tabindex="-1" autocomplete="off" />
      </div>

      <div class="flex flex-col gap-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <Label for="contact-first-name">
              First Name <span class="text-error" aria-hidden="true">*</span>
            </Label>
            <Input
              id="contact-first-name"
              name="firstName"
              type="text"
              required
              autocomplete="given-name"
              placeholder="Jane"
              aria-describedby="error-firstName"
            />
            <p id="error-firstName" data-field-error="firstName" class="hidden text-sm font-medium text-error" role="alert"></p>
          </div>

          <div class="flex flex-col gap-2">
            <Label for="contact-last-name">
              Last Name <span class="text-error" aria-hidden="true">*</span>
            </Label>
            <Input
              id="contact-last-name"
              name="lastName"
              type="text"
              required
              autocomplete="family-name"
              placeholder="Doe"
              aria-describedby="error-lastName"
            />
            <p id="error-lastName" data-field-error="lastName" class="hidden text-sm font-medium text-error" role="alert"></p>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <Label for="contact-email">
              Email <span class="text-error" aria-hidden="true">*</span>
            </Label>
            <Input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              aria-describedby="error-email"
            />
            <p id="error-email" data-field-error="email" class="hidden text-sm font-medium text-error" role="alert"></p>
          </div>

          <div class="flex flex-col gap-2">
            <Label for="contact-phone">Phone Number</Label>
            <Input
              id="contact-phone"
              name="phoneNumber"
              type="tel"
              autocomplete="tel"
              placeholder="(937) 555-0100"
              aria-describedby="error-phoneNumber"
            />
            <p id="error-phoneNumber" data-field-error="phoneNumber" class="hidden text-sm font-medium text-error" role="alert"></p>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <Label for="contact-message">
            Message <span class="text-error" aria-hidden="true">*</span>
          </Label>
          <Textarea
            id="contact-message"
            name="message"
            rows={4}
            required
            placeholder="How can Dr. Kirpaul help you?"
            aria-describedby="error-message"
          />
          <p id="error-message" data-field-error="message" class="hidden text-sm font-medium text-error" role="alert"></p>
        </div>
      </div>

      <div id="contact-status" aria-live="polite" class="space-y-2">
        <div id="contact-success-alert" class="hidden">
          <Alert variant="success" class="flex items-center gap-3 border-green-600/30 bg-green-50 text-green-900 dark:border-green-500/30 dark:bg-green-950/40 dark:text-green-100">
            <CircleCheck class="size-5 shrink-0 text-green-700 dark:text-green-400" aria-hidden="true" />
            <AlertDescription id="contact-success-text" class="text-sm font-medium">
              You have successfully sent your message.
            </AlertDescription>
          </Alert>
        </div>

        <div id="contact-error-alert" class="hidden">
          <Alert variant="error" class="flex items-center gap-3">
            <CircleAlert class="size-5 shrink-0 text-error dark:text-red-400" aria-hidden="true" />
            <AlertDescription id="contact-error-text" class="text-sm font-medium">
              Your message could not be sent. Please try again later.
            </AlertDescription>
          </Alert>
        </div>
      </div>

      <Button id="contact-submit" type="submit" variant="primary" size="lg" class="w-full shadow-xs">
        <Spinner id="contact-spinner" class="hidden size-4 text-current" />
        <Send id="contact-send-icon" class="size-4" aria-hidden="true" />
        <span id="contact-submit-label">Send Message</span>
      </Button>

      <p class="flex items-start gap-2 text-xs text-muted-foreground">
        <Lock class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/70" aria-hidden="true" />
        <span>
          For your privacy, please avoid including sensitive medical records or Protected Health Information (PHI) in
          this form. For urgent medical needs, call the office directly.
        </span>
      </p>
    </form>
  </CardContent>
</Card>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;
  const submitLabel = document.getElementById("contact-submit-label");
  const spinner = document.getElementById("contact-spinner");
  const sendIcon = document.getElementById("contact-send-icon");
  const successAlert = document.getElementById("contact-success-alert");
  const successText = document.getElementById("contact-success-text");
  const errorAlert = document.getElementById("contact-error-alert");
  const errorText = document.getElementById("contact-error-text");

  interface AntiSpamState {
    token: string;
    salt: string;
    difficulty: number;
    solution: number | string;
    timestamp: number;
  }

  let antiSpamState: AntiSpamState | null = null;
  let challengePromise: Promise<AntiSpamState | null> | null = null;

  async function solvePoW(salt: string, difficulty: number): Promise<number> {
    if (difficulty <= 0) return 0;
    const prefix = "0".repeat(difficulty);
    const encoder = new TextEncoder();
    let nonce = 0;
    while (nonce < 1_000_000) {
      const data = encoder.encode(`${salt}:${nonce}`);
      const hashBuffer = await crypto.subtle.digest("SHA-256", data);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      const hex = hashArray.map((b) => b.toString(16).padStart(2, "0")).join("");
      if (hex.startsWith(prefix)) {
        return nonce;
      }
      nonce += 1;
    }
    return nonce;
  }

  async function loadAntiSpamChallenge(): Promise<AntiSpamState | null> {
    try {
      const res = await fetch("/api/contact", {
        method: "GET",
        headers: { Accept: "application/json" },
      });
      if (!res.ok) return null;
      const data = (await res.json()) as {
        ok?: boolean;
        token?: string;
        salt?: string;
        difficulty?: number;
      };
      if (data.ok && data.token && data.salt && typeof data.difficulty === "number") {
        const solution = await solvePoW(data.salt, data.difficulty);
        const state: AntiSpamState = {
          token: data.token,
          salt: data.salt,
          difficulty: data.difficulty,
          solution,
          timestamp: Date.now(),
        };
        antiSpamState = state;
        return state;
      }
    } catch {
      // Non-blocking background fetch
    }
    return null;
  }

  function getOrFetchChallenge(): Promise<AntiSpamState | null> {
    if (antiSpamState && Date.now() - antiSpamState.timestamp < 90 * 60 * 1000) {
      return Promise.resolve(antiSpamState);
    }
    if (!challengePromise) {
      challengePromise = loadAntiSpamChallenge().finally(() => {
        challengePromise = null;
      });
    }
    return challengePromise;
  }

  if (typeof window !== "undefined") {
    const triggerEvents = ["focusin", "pointerenter", "touchstart", "keydown"] as const;
    for (const evt of triggerEvents) {
      form?.addEventListener(
        evt,
        () => {
          void getOrFetchChallenge();
        },
        { once: true, passive: true },
      );
    }
  }

  function clearFieldErrors() {
    document.querySelectorAll<HTMLElement>("[data-field-error]").forEach((el) => {
      el.textContent = "";
      el.classList.add("hidden");
    });
    form?.querySelectorAll<HTMLElement>("[aria-invalid='true']").forEach((el) => {
      el.removeAttribute("aria-invalid");
    });
  }

  function showFieldErrors(fieldErrors: Record<string, string>) {
    for (const [field, message] of Object.entries(fieldErrors)) {
      const errorEl = document.querySelector<HTMLElement>(`[data-field-error="${field}"]`);
      const inputEl = form?.querySelector<HTMLElement>(`[name="${field}"]`);
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      }
      if (inputEl) {
        inputEl.setAttribute("aria-invalid", "true");
      }
    }
  }

  function setLoading(isLoading: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = isLoading;
    spinner?.classList.toggle("hidden", !isLoading);
    sendIcon?.classList.toggle("hidden", isLoading);
    if (submitLabel) {
      submitLabel.textContent = isLoading ? "Sending..." : "Send Message";
    }
  }

  async function submitPayload(payload: Record<string, unknown>) {
    const response = await fetch("/api/contact", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    return (await response.json()) as {
      ok?: boolean;
      message?: string;
      error?: string;
      code?: string;
      fieldErrors?: Record<string, string>;
    };
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    clearFieldErrors();
    successAlert?.classList.add("hidden");
    errorAlert?.classList.add("hidden");

    setLoading(true);

    try {
      let challenge = await getOrFetchChallenge();

      const formData = new FormData(form);
      const payload: Record<string, unknown> = {
        email: String(formData.get("email") ?? ""),
        firstName: String(formData.get("firstName") ?? ""),
        lastName: String(formData.get("lastName") ?? ""),
        phoneNumber: String(formData.get("phoneNumber") ?? ""),
        message: String(formData.get("message") ?? ""),
        website: String(formData.get("website") ?? ""),
        company: String(formData.get("company") ?? ""),
        antiSpamToken: challenge?.token ?? "",
        antiSpamSolution: challenge?.solution ?? "",
      };

      let result = await submitPayload(payload);

      // If token expired, transparently refresh challenge and retry once
      if (!result.ok && result.code === "TOKEN_EXPIRED") {
        antiSpamState = null;
        challenge = await loadAntiSpamChallenge();
        if (challenge) {
          payload.antiSpamToken = challenge.token;
          payload.antiSpamSolution = challenge.solution;
          result = await submitPayload(payload);
        }
      }

      if (result.ok) {
        if (successText && result.message) {
          successText.textContent = result.message;
        }
        successAlert?.classList.remove("hidden");
        form.reset();
        antiSpamState = null;
        void getOrFetchChallenge();
        return;
      }

      if (result.fieldErrors) {
        showFieldErrors(result.fieldErrors);
      }
      if (errorText) {
        errorText.textContent = result.error ?? "Please check your entries and try again.";
      }
      errorAlert?.classList.remove("hidden");
    } catch {
      if (errorText) {
        errorText.textContent = "Network error. Please try again later or call the office directly.";
      }
      errorAlert?.classList.remove("hidden");
    } finally {
      setLoading(false);
    }
  });
</script>
