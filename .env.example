# Server configuration (used by @astrojs/node standalone server)
HOST=127.0.0.1
PORT=4321

# Contact Form Delivery: Option A (SMTP via Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
CONTACT_FROM_EMAIL=noreply@example.com
CONTACT_TO_EMAIL=office@example.com

# Contact Form Delivery: Option B (Webhook URL, used if SMTP_HOST is unset)
# CONTACT_WEBHOOK_URL=https://hooks.example.com/contact

# Optional: allow log-only mode in production when testing without SMTP/webhook
# ALLOW_LOG_ONLY_CONTACT=false

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# PUBLIC_GA_ID=
