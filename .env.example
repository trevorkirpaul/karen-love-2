# Contact API Server configuration
HOST=127.0.0.1
PORT=4321

# Contact Form Delivery: Option A (Resend HTTP API - Recommended)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=website@karenkirpaul.com
CONTACT_TO_EMAIL=office@karenkirpaul.com

# Contact Form Delivery: Option B (SMTP via Nodemailer, used if RESEND_API_KEY is unset)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Contact Form Delivery: Option C (Webhook URL, used if RESEND_API_KEY and SMTP_HOST are unset)
# CONTACT_WEBHOOK_URL=https://hooks.example.com/contact

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# PUBLIC_GA_ID=
